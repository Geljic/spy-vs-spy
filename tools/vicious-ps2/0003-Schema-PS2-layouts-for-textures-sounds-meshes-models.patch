+  });
+  /** PS2 only: the smooth-skinned part, 16 bytes per vertex (vicious' Xbox "rigged" buffers) */
+  ps2Skinned = field(PS2SkinnedPart, {
+    condition: (ctx) => isPS2Enabled(ctx, this.enabled),
+    custom: (ctx) => {
+      ctx.set(this.ps2Skinned.rigid, false);
+      ctx.walk();
+    },
+  });
+  /** PS2 only: 32 lists (one per section) of SkinMeshFrame */
+  ps2Frames = field((ctx) => ctx.array(PS2SkinFrameList, 32), {
