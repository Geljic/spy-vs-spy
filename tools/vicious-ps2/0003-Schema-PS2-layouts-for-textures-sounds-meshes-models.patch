 import { StaticGeom } from "./staticGeom";
 
 export class Model extends Class {
@@ -19,6 +21,7 @@ export class VertexBuffer extends Struct {
 
   enabled = field(BOOL);
   buffer = field(U8Buffer, {
+    condition: (ctx) => ctx.neq((ctx) => ctx.platform(), 1),
     custom: (ctx) => {
       ctx.if(
         (ctx) => ctx.isTrue(this.enabled),
@@ -29,4 +32,73 @@ export class VertexBuffer extends Struct {
       );
     },
   });
+  /** PS2 only: the static mesh these vertex colours belong to */
+  ps2Mesh = field(AssetReference, {
+    condition: (ctx) => isPS2Enabled(ctx, this.enabled),
+  });
+  /**
+   * PS2 only: one 16-bit colour per vertex of ps2Mesh, sliced per batch in the mesh's batch
+   * order, each slice padded to 16 bytes
+   */
+  ps2Colors = field(U8Buffer, {
+    condition: (ctx) => isPS2Enabled(ctx, this.enabled),
+    custom: (ctx) => {
+      ctx.set(this.ps2Colors.consume, true);
+      ctx.walk();
+    },
+  });
+  ps2GroupCount = field(U32, { skip: true });
+  /** PS2 only: a copy of the mesh's group/batch table. No count in the file: it runs to the chunk end */
+  ps2Groups = field((ctx) => ctx.list(PS2StaticMeshGroup, 1024), {
+    condition: (ctx) => isPS2Enabled(ctx, this.enabled),
+    custom: (ctx) => {
+      readGroupsToChunkEnd(ctx, this.ps2Groups, this.ps2GroupCount);
+    },
+  });
+}
+
+/**
+ * PS2: read PS2StaticMeshGroup entries until the end of the current chunk (the file has no
+ * count). The decoder stops at end(); the other backends emit end() as 1 and use `count`,
+ * which the decoder filled in.
+ */
+export function readGroupsToChunkEnd(ctx: CodeContext, list: any, count: any) {
+  ctx.allocate(list);
+  ctx.set(count, 0);
+  ctx.loop((ctx) => {
+    const i = ctx.var(U32, (ctx) => ctx.iterator());
+    ctx.if(
+      (ctx) =>
+        ctx.or(
+          (ctx) => ctx.gte(i, 1024),
+          (ctx) =>
+            ctx.or(
+              (ctx) =>
+                ctx.and(
+                  (ctx) => ctx.neq((ctx) => ctx.end(), 1),
+                  (ctx) =>
+                    ctx.gte(
+                      (ctx) => ctx.add((ctx) => ctx.tell(), 3),
+                      (ctx) => ctx.end()
+                    )
+                ),
+              (ctx) =>
+                ctx.and(
+                  (ctx) => ctx.eq((ctx) => ctx.end(), 1),
+                  (ctx) => ctx.gte(i, count)
+                )
+            )
+        ),
+      (ctx) => ctx.break()
+    );
+    ctx.walk((ctx) => ctx.index(list, i));
+    ctx.set(count, (ctx) => ctx.add(i, 1));
+  });
+}
+
+export function isPS2Enabled(ctx: CodeContext, enabled: any) {
+  return ctx.and(
+    (ctx) => ctx.isTrue(enabled),
+    (ctx) => ctx.eq((ctx) => ctx.platform(), 1)
+  );
 }
