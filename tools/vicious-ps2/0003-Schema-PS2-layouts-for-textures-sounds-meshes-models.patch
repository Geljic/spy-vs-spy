+  });
+}
+
+function isXboxEnabled(ctx: CodeContext, enabled: any) {
+  return ctx.and(
+    (ctx) => ctx.isTrue(enabled),
+    (ctx) => ctx.neq((ctx) => ctx.platform(), 1)
+  );
+}
+
+function isPS2Enabled(ctx: CodeContext, enabled: any) {
+  return ctx.and(
+    (ctx) => ctx.isTrue(enabled),
+    (ctx) => ctx.eq((ctx) => ctx.platform(), 1)
+  );
+}
+
+/**
+ * PS2 dynamic mesh part (DynamicMesh v6 body). groupCount = sum of sectionCounts; sectionCounts[i]
+ * groups belong to section i (a joint/matrix slot). Blobs are u32 size + bytes, sliced per batch with
+ * each slice padded to 16 bytes:
+ *   rigid:   blob0 positions int16x3, blob1 normals int16x3, blob2 UVs int16x2, blob3 strip indices u8
+ *            (the same four blobs as a static mesh, notes/formats.md#render-mesh)
+ *   skinned: blob0 vertices, 16 bytes each, size given in quadwords; blob1 UVs int16x2; blob2 strips u8
+ * Groups use the static mesh batch layout.
+ */
+export class PS2SkinnedPart extends Struct {
+  rigid = field(BOOL, { skip: true });
+  groupCount = field(U32);
+  sectionCounts = field((ctx) => ctx.array(U8, 32));
+  blob0QuadWords = field(U32, {
+    condition: (ctx) =>
+      ctx.and(
+        (ctx) => ctx.gt(this.groupCount, 0),
+        (ctx) => ctx.isFalse(this.rigid)
+      ),
+  });
+  blob0 = field(U8Buffer, {
+    condition: (ctx) => ctx.gt(this.groupCount, 0),
+    custom: (ctx) => {
+      ctx.if(
+        (ctx) => ctx.isTrue(this.rigid),
+        (ctx) => ctx.set(this.blob0.consume, true),
+        (ctx) => {
+          ctx.set(this.blob0.consume, false);
+          ctx.set(this.blob0.size, (ctx) => ctx.mul(this.blob0QuadWords, 16));
+        }
+      );
+      ctx.walk();
+    },
+  });
+  blob1 = field(U8Buffer, {
+    condition: (ctx) => ctx.gt(this.groupCount, 0),
+    custom: (ctx) => {
+      ctx.set(this.blob1.consume, true);
+      ctx.walk();
+    },
+  });
+  blob2 = field(U8Buffer, {
+    condition: (ctx) => ctx.gt(this.groupCount, 0),
+    custom: (ctx) => {
+      ctx.set(this.blob2.consume, true);
+      ctx.walk();
+    },
+  });
+  blob3 = field(U8Buffer, {
+    condition: (ctx) =>
+      ctx.and(
+        (ctx) => ctx.gt(this.groupCount, 0),
+        (ctx) => ctx.isTrue(this.rigid)
+      ),
+    custom: (ctx) => {
+      ctx.set(this.blob3.consume, true);
+      ctx.walk();
+    },
+  });
+  sections = field((ctx) => ctx.array(PS2SkinSection, 32), {
+    condition: (ctx) => ctx.gt(this.groupCount, 0),
+    custom: (ctx) => {
+      ctx.for(32, (ctx) => {
+        ctx.set(
+          ctx.index(this.sections, (ctx) => ctx.iterator()).rigid,
+          this.rigid
+        );
+        ctx.set(
+          ctx.index(this.sections, (ctx) => ctx.iterator()).count,
+          (ctx) => ctx.index(this.sectionCounts, (ctx) => ctx.iterator())
+        );
+        ctx.walk((ctx) => ctx.index(this.sections, (ctx) => ctx.iterator()));
+      });
+    },
+  });
+}
+
+export class PS2SkinSection extends Struct {
+  rigid = field(BOOL, { skip: true });
+  count = field(U8, { skip: true });
+  /** Rigid part: same layout as a static mesh group */
+  rigidGroups = field((ctx) => ctx.list(PS2StaticMeshGroup), {
+    condition: (ctx) =>
+      ctx.and(
+        (ctx) => ctx.isTrue(this.rigid),
+        (ctx) => ctx.gt(this.count, 0)
+      ),
+    custom: (ctx) => {
+      ctx.allocate(this.rigidGroups, this.count);
+      ctx.for(this.count, (ctx) => {
+        ctx.walk((ctx) => ctx.index(this.rigidGroups, (ctx) => ctx.iterator()));
+      });
+    },
+  });
+  /** Skinned part: no material slot */
+  skinnedGroups = field((ctx) => ctx.list(PS2SkinnedGroup), {
+    condition: (ctx) =>
+      ctx.and(
+        (ctx) => ctx.isFalse(this.rigid),
+        (ctx) => ctx.gt(this.count, 0)
+      ),
+    custom: (ctx) => {
+      ctx.allocate(this.skinnedGroups, this.count);
+      ctx.for(this.count, (ctx) => {
+        ctx.walk((ctx) => ctx.index(this.skinnedGroups, (ctx) => ctx.iterator()));
+      });
+    },
+  });
+}
+
+export class PS2SkinnedGroup extends Struct {
+  f_1 = field(U32);
+  batchCount = field(U32);
+  f_2 = field(U32);
+  batches = field((ctx) => ctx.list(PS2StaticMeshBatch), {
+    custom: (ctx) => {
+      ctx.allocate(this.batches, this.batchCount);
+      ctx.for(this.batchCount, (ctx) => {
+        ctx.walk((ctx) => ctx.index(this.batches, (ctx) => ctx.iterator()));
+      });
+    },
+  });
+}
+
+export class PS2SkinFrameList extends Struct {
+  count = field(U32);
+  list = field((ctx) => ctx.list(SkinMeshFrame), {
+    custom: (ctx) => {
+      ctx.allocate(this.list, this.count);
+      ctx.for(this.count, (ctx) => {
+        ctx.walk((ctx) => ctx.index(this.list, (ctx) => ctx.iterator()));
+      });
+    },
+  });
 }
