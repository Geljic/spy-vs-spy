+  /** PS2 only: the rigid part: groups move with one joint slot each (vicious' Xbox "static" ranges) */
+  ps2Rigid = field(PS2SkinnedPart, {
+    condition: (ctx) => isPS2Enabled(ctx, this.enabled),
