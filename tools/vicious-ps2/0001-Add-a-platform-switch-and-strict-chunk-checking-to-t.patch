diff --git a/packages/c/include/vicious/context.h b/packages/c/include/vicious/context.h
index 77ddf92..043c4e0 100644
--- a/packages/c/include/vicious/context.h
+++ b/packages/c/include/vicious/context.h
@@ -1,17 +1,30 @@
 #ifndef VICIOUS_CONTEXT
 #define VICIOUS_CONTEXT
 
+#include <setjmp.h>
 #include <stdio.h>
 
 #include "./generated.h"
 #include "./memory.h"
 
+#define STD_DECODER_MAX_DEPTH 512
+
 typedef struct {
     DecoderContext ctx;
 
     FILE *file;
     Arena *arena;
     AssetPool *pool;
+
+    /* Chunk checking (see stdDecoderStrict) */
+    bool strict;
+    jmp_buf *bail;
+    U32 errors;
+    U32 chunks;
+    I32 depth;
+    const char *names[STD_DECODER_MAX_DEPTH];
+    U32 starts[STD_DECODER_MAX_DEPTH];
+    U32 ends[STD_DECODER_MAX_DEPTH];
 } StdDecoder;
 
 typedef struct {
@@ -28,6 +41,24 @@ typedef struct {
  */
 void stdDecoder(StdDecoder *ctx, FILE *file, AssetPool *pool, Arena *arena);
 
+/**
+ * Enable strict chunk checking: every chunk must end exactly at its end offset
+ * (after 4-byte alignment). On the first error the chunk stack is printed and, when
+ * `bail` is set, the decoder longjmp()s to it with value 1.
+ */
+void stdDecoderStrict(StdDecoder *ctx, jmp_buf *bail);
+
+/**
+ * Print the current file offset and chunk stack to stderr (for crash handlers)
+ */
+void stdDecoderTrace(StdDecoder *ctx);
+
+/**
+ * Set viciousPlatform from the VICIOUS_PLATFORM environment variable
+ * ("ps2" or "1" = PS2, anything else = Xbox). Called by stdDecoder().
+ */
+void viciousPlatformFromEnv(void);
+
 /**
  * Create a libc EncoderContext
  */
diff --git a/packages/c/src/context.c b/packages/c/src/context.c
index 0b95cc2..48e47ae 100644
--- a/packages/c/src/context.c
+++ b/packages/c/src/context.c
@@ -1,7 +1,76 @@
 #include <vicious/context.h>
 
+#include <stdlib.h>
+#include <string.h>
+
+U32 viciousPlatform = 0;
+
+void viciousPlatformFromEnv(void) {
+    const char *env = getenv("VICIOUS_PLATFORM");
+
+    if (env == NULL) return;
+
+    viciousPlatform = (strcmp(env, "ps2") == 0 || strcmp(env, "PS2") == 0 || strcmp(env, "1") == 0) ? 1 : 0;
+}
+
+void stdDecoderTrace(StdDecoder *self) {
+    fprintf(stderr, "  at offset 0x%lx, chunk stack (innermost last):\n", ftell(self->file));
+
+    for (I32 i = 0; i < self->depth && i < STD_DECODER_MAX_DEPTH; i++) {
+        fprintf(stderr, "    %*s%s [0x%x..0x%x]\n", i, "", self->names[i], self->starts[i], self->ends[i]);
+    }
+}
+
+static void stdDecoderFail(StdDecoder *self) {
+    self->errors++;
+
+    if (self->strict) {
+        stdDecoderTrace(self);
+
+        if (self->bail != NULL) longjmp(*self->bail, 1);
+    }
+}
+
 static void stdDecoderLog(StdDecoder *self, const char *scope, const char *message) {
     printf("%s: %s\n", scope, message);
+
+    if (strcmp(scope, "ERROR") == 0) {
+        if (self->strict) fprintf(stderr, "ERROR: %s\n", message);
+        stdDecoderFail(self);
+    }
+}
+
+static void stdDecoderEnterChunk(StdDecoder *self, const char *name, U32 end, U32 version) {
+    U32 start = (U32)ftell(self->file) - 12;
+
+    if (self->depth >= 0 && self->depth < STD_DECODER_MAX_DEPTH) {
+        self->names[self->depth] = name;
+        self->starts[self->depth] = start;
+        self->ends[self->depth] = end;
+    }
+
+    self->depth++;
+    self->chunks++;
+
+    if (self->strict && (end < start + 12 || (self->depth > 1 && self->depth <= STD_DECODER_MAX_DEPTH && end > self->ends[self->depth - 2]))) {
+        fprintf(stderr, "ERROR: %s v%u: bad end offset 0x%x\n", name, version, end);
+        stdDecoderFail(self);
+    }
+}
+
+static void stdDecoderExitChunk(StdDecoder *self, const char *name, U32 end) {
+    if (self->strict) {
+        U32 at = (U32)ftell(self->file);
+        U32 aligned = (at + 3) & ~3u;
+
+        if (aligned != end) {
+            fprintf(stderr, "ERROR: %s chunk ends at 0x%x but data stops at 0x%x (%s by %d bytes)\n", name, end, at,
+                at > end ? "over-read" : "under-read", at > end ? (int)(at - end) : (int)(end - at));
+            stdDecoderFail(self);
+        }
+    }
+
+    self->depth--;
 }
 
 static U32 stdDecoderTell(StdDecoder *self) {
@@ -22,7 +91,12 @@ static void stdDecoderSetId(StdDecoder *self, ID id, U32 typeId, void *asset) {
 
 static void * stdDecoderAllocate(StdDecoder *self, U32 size, U32 count) {
     if (self->arena != NULL) {
-        return arenaAllocate(self->arena, (size_t)size * (size_t)count);
+        void *ptr = arenaAllocate(self->arena, (size_t)size * (size_t)count);
+
+        /* Arena full (big PS2 maps): fall back to the heap instead of returning NULL */
+        if (ptr == NULL && (size_t)size * (size_t)count > 0) ptr = calloc(count, size);
+
+        return ptr;
     } else {
         return malloc((size_t)size * (size_t) count);
     }
@@ -39,7 +113,9 @@ static DecoderContext STD_DECODER = {
     .getId = (void *)stdDecoderGetId,
     .setId = (void *)stdDecoderSetId,
     .allocate = (void *)stdDecoderAllocate,
-    .read = (void *)stdDecoderRead
+    .read = (void *)stdDecoderRead,
+    .enterChunk = (void *)stdDecoderEnterChunk,
+    .exitChunk = (void *)stdDecoderExitChunk
 };
 
 void stdDecoder(StdDecoder *self, FILE *file, AssetPool *pool, Arena *arena) {
@@ -47,6 +123,18 @@ void stdDecoder(StdDecoder *self, FILE *file, AssetPool *pool, Arena *arena) {
     self->file = file;
     self->arena = arena;
     self->pool = pool;
+    self->strict = false;
+    self->bail = NULL;
+    self->errors = 0;
+    self->chunks = 0;
+    self->depth = 0;
+
+    viciousPlatformFromEnv();
+}
+
+void stdDecoderStrict(StdDecoder *self, jmp_buf *bail) {
+    self->strict = true;
+    self->bail = bail;
 }
 
 static void stdEncoderLog(StdEncoder *self, const char *scope, const char *message) {
