+++ b/packages/c/codegen/decoder.ts
@@ -45,6 +45,10 @@ function buildContext(): string {
 
       void *(*allocate)(struct DecoderContext *ctx, U32 size, U32 count);
       void (*read)(struct DecoderContext *ctx, void *ptr, U32 size, U32 count);
+
+      /* Optional chunk hooks (NULL = off): called after a chunk header is read and before its footer */
+      void (*enterChunk)(struct DecoderContext *ctx, const char *name, U32 end, U32 version);
