 class DefinitionDecoderImplementation extends CEmit {
+  private chunkName: string = "";
+
+  protected visitClass(cls: Class): void {
+    this.chunkName = cls.constructor.name;
+    super.visitClass(cls);
+  }
+
+  protected visitStruct(struct: Struct): void {
+    this.chunkName = struct.constructor.name;
+    super.visitStruct(struct);
+  }
+
   protected emitObject(obj: any, handler: string): string {
     const typeName = obj.constructor.name;
 
@@ -157,11 +173,13 @@ class DefinitionDecoderImplementation extends CEmit {
       decodeMetadataHeader(ctx, &self->metadata.header);
       U32 __version = self->metadata.header.version;
       U32 __end = self->metadata.header.end;
+      if (ctx->enterChunk) ctx->enterChunk(ctx, "${this.chunkName}", __end, __version);
     `;
   }
 
   protected emitMetadataFooter(): string {
     return cg`
+      if (ctx->exitChunk) ctx->exitChunk(ctx, "${this.chunkName}", __end);
       decodeMetadataFooter(ctx, &self->metadata.footer);
     `;
   }
